name: Build plugin

on:
  push:
    branches: [ "main", "master" ]
  workflow_dispatch: {}

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - name: Pobierz kod
        uses: actions/checkout@v4

      - name: Zainstaluj JDK 21
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '21'
          cache: maven

      - name: Zbuduj plugin (mvn package)
        working-directory: zamek-z-piasku
        run: mvn -B clean package

      - name: Udostepnij gotowy .jar do pobrania
        uses: actions/upload-artifact@v4
        with:
          name: ZamekZPiasku-jar
          path: zamek-z-piasku/target/*.jar
